body {
  margin: 0;
  background: black;
  color: white;
  font-family: "Courier New", monospace;
  overflow: hidden;
  text-transform: lowercase;
}

.project-header {
  position: fixed;
  top: 8px;
  left: 8px;
  z-index: 1000;
  font-size: 11px;
  line-height: 1.35;
  background: rgba(0, 0, 0, 0.78);
  border: 1px solid white;
  padding: 8px 10px;
  max-width: 260px;
}

.screen {
  width: 100vw;
  height: 100vh;
  display: grid;
  gap: 2px;
  background: white;
  box-sizing: border-box;
}

.start-layout {
  grid-template-columns: 1.2fr 1fr;
  grid-template-rows: 1fr 90px;
}

.split-layout-1 {
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
}

.split-layout-2 {
  grid-template-columns: 1fr 1fr 1fr;
  grid-template-rows: 1fr 1fr;
}

.split-layout-3 {
  grid-template-columns: 1fr 1fr 1fr;
  grid-template-rows: 1fr 1fr 1fr;
}

.frame {
  background: black;
  border: 1px solid white;
  box-sizing: border-box;
  overflow: hidden;
  position: relative;
}

.image-frame,
.small-image-frame {
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-frame img,
.small-image-frame img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.nyc-tone img {
  filter: grayscale(80%) contrast(140%) brightness(70%);
}

.reading-tone img {
  filter: grayscale(40%) brightness(95%) contrast(90%);
}

.military-tone img {
  filter: contrast(120%) brightness(95%) saturate(90%);
}

.childhood-tone img {
  filter: grayscale(35%) brightness(88%) contrast(95%);
}

.jail-tone img {
  filter: grayscale(100%) contrast(150%) brightness(55%);
}

.text-frame,
.small-text-frame {
  padding: 18px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  line-height: 1.7;
  font-size: 18px;
}

.small-text-frame {
  font-size: 14px;
  line-height: 1.5;
}

.choice-frame,
.small-choice-frame {
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  padding: 12px;
  text-align: center;
  transition: background 0.2s, color 0.2s;
  font-size: 15px;
}

.choice-frame:hover,
.small-choice-frame:hover {
  background: white;
  color: black;
}

.faint {
  opacity: 0.78;
}

.flash {
  animation: flicker 2.4s infinite;
}

@keyframes flicker {
  0% { opacity: 1; }
  50% { opacity: 0.88; }
  100% { opacity: 1; }
}

@media (max-width: 900px) {
  .project-header {
    font-size: 10px;
    max-width: 200px;
  }

  .start-layout,
  .split-layout-1,
  .split-layout-2,
  .split-layout-3 {
    grid-template-columns: 1fr;
    grid-template-rows: repeat(auto-fit, minmax(90px, auto));
    height: auto;
    min-height: 100vh;
    padding-top: 70px;
  }

  body {
    overflow: auto;
  }
}
